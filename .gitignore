# docs/ is internal by default (session journals, planning, competitive notes).
# Whitelist ONLY what an external contributor needs — one named negation each.
# Placed LAST on purpose: the last matching pattern wins, so these negations must
# come after the `*.png` rule above for docs/images/*.png to survive.
docs/*
!docs/images/
!docs/images/**
!docs/architecture.md
!docs/chord-types.md
